# Sanctify-Hivemind — environment config (copy to .env; .env is gitignored)
# Credential-free repo: NEVER commit real values.

# Required for any run
WP_URL=https://www.example.com

# Optional: authenticated WP REST (plugin versions, post/meta updates)
WP_USER=
WP_APP_PASSWORD=

# Optional: FTP (file scan / cleanup / snapshot-restore)
FTP_HOST=
FTP_USER=
FTP_PASS=
FTP_ROOT=/
